{
  "manifest_version": 3,
  "name": "Sorkalam",
  "version": "6.0.0",
  "description": "சொற்களம்: Tamil ↔ English — Wiktionary & Tamil VU glossaries in-popup; Grok & Grokipedia for deeper research",
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },

  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },

  "background": {
    "service_worker": "event.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],

  "host_permissions": [
    "https://*.wiktionary.org/*",
    "https://www.tamilvu.org/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}